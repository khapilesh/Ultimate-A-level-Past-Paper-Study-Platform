   dc:format="image/tiff"
   photoshop:Credit="ANDREW LAMBERT PHOTOGRAPHY/SCIENCE PHOTO LIBRARY"
   photoshop:TransmissionReference="A400/0083"
   photoshop:LegacyIPTCDigest="4E5C9C87F04FBD35383E2BE2EBEAA952"
   photoshop:Headline="Electron diffraction pattern"
   photoshop:Source="ALM"
   photoshop:ColorMode="1"
