   exif:PixelXDimension="467"
   exif:PixelYDimension="461">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>ANDREW LAMBERT PHOTOGRAPHY/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Electron diffraction pattern. Demonstration of wave-particle duality. An electron gun has been fired at a thin sheet of graphite. The electrons passed through and hit a luminescent screen, producing the patterns of rings associated with diffraction. Diffraction occurs when a wave passes through an aperture similar in size to its wavelength. But electrons are particles, so should not exhibit the same phenomenon unless they can also behave like waves. De Broglie (1892- 1987) correctly deduced that this was the case and that particles have wavelengths inversely proportional to their momentum.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">ANDREW LAMBERT PHOTOGRAPHY/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Electron diffraction pattern</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>physical</rdf:li>
     <rdf:li>wave-particle</rdf:li>
     <rdf:li>duality</rdf:li>
     <rdf:li>diffraction</rdf:li>
     <rdf:li>patterns</rdf:li>
     <rdf:li>de</rdf:li>
     <rdf:li>broglie</rdf:li>
     <rdf:li>hypothesis</rdf:li>
     <rdf:li>de</rdf:li>
     <rdf:li>broglie</rdf:li>
     <rdf:li>wavelength</rdf:li>
     <rdf:li>electrons</rdf:li>
